{
  "name": "virtuoffice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "start": "tsx server.ts",
    "lint": "eslint",
    "test": "node --import tsx --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --test src/features/attendance/session-time.test.mjs src/features/activity/timing.test.mjs src/features/notifications/types.test.mjs src/features/presence/presence.test.mjs src/features/workspace-3d/layout.test.mjs tests/compatibility.test.mjs",
    "test:integration": "node --env-file=.env --import tsx --test tests/compatibility.integration.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "next": "16.3.5",
    "next-intl": "^4.14.4",
    "openid-client": "^6.8.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.186.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "6.12.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
